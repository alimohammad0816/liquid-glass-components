{
  "name": "liquid-glass-components",
  "version": "1.0.0",
  "description": "Liquid glass UI components for React: edge refraction, dynamic specular light, spring physics and metaball merging.",
  "keywords": [
    "react",
    "liquid-glass",
    "glassmorphism",
    "ui-components",
    "refraction",
    "backdrop-filter",
    "motion",
    "typescript"
  ],
  "homepage": "https://github.com/alimohammad0816/liquid-glass-components#readme",
  "bugs": {
    "url": "https://github.com/alimohammad0816/liquid-glass-components/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alimohammad0816/liquid-glass-components.git"
  },
  "license": "MIT",
  "author": "alimohammad0816 (https://github.com/alimohammad0816)",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build": "tsup",
    "build:demo": "vite build --config demo/vite.config.ts",
    "preview": "vite preview --config demo/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "motion": ">=12",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "lucide-react": "^1.49.0",
    "motion": "^13.4.6",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
